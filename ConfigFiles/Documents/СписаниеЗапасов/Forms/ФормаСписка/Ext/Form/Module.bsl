
&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	ЭлементыФормы = Элементы.Добавить("ОбщаяСтоимостьСписания", Тип("ПолеФормы"), Элементы.Список);
	ЭлементыФормы.Вид = ВидПоляФормы.ПолеНадписи;
	ЭлементыФормы.ПутьКДанным = "Список.ОбщаяСтоимостьСписания";

КонецПроцедуры
